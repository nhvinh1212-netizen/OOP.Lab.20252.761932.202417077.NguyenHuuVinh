<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="hust.soict.dsai.aims.screen.CartScreenController"
            prefWidth="1024"
            prefHeight="768">

    <top>

        <VBox>

            <MenuBar>

                <Menu text="Options">

                    <Menu text="Update Store">

                        <MenuItem text="Add Book"/>
                        <MenuItem text="Add CD"/>
                        <MenuItem text="Add DVD"/>

                    </Menu>

                    <MenuItem text="View Store"/>
                    <MenuItem text="View Cart"/>

                </Menu>

            </MenuBar>

            <Label text="CART"
                   style="-fx-font-size: 50px;
                          -fx-text-fill: cyan;">

                <padding>
                    <Insets top="10"
                            left="10"
                            bottom="10"/>
                </padding>

            </Label>

        </VBox>

    </top>

    <center>

        <VBox spacing="10">

            <padding>
                <Insets top="10"
                        left="10"
                        right="10"
                        bottom="10"/>
            </padding>

            <HBox spacing="10">

                <Label text="Filter:"/>

                <TextField fx:id="tfFilter"
                           prefWidth="250"/>

                <RadioButton fx:id="radioBtnFilterId"
                             text="By ID"
                             selected="true">

                    <toggleGroup>
                        <ToggleGroup fx:id="filterCategory"/>
                    </toggleGroup>

                </RadioButton>

                <RadioButton fx:id="radioBtnFilterTitle"
                             text="By Title"
                             toggleGroup="$filterCategory"/>

            </HBox>

            <TableView fx:id="tblMedia"
                       prefHeight="500">

                <columns>

                    <TableColumn fx:id="colMediaTitle"
                                 text="Title"
                                 prefWidth="400"/>

                    <TableColumn fx:id="colMediaCategory"
                                 text="Category"
                                 prefWidth="250"/>

                    <TableColumn fx:id="colMediaCost"
                                 text="Cost"
                                 prefWidth="150"/>

                </columns>

            </TableView>

            <ButtonBar>

                <buttons>

                    <Button fx:id="btnPlay"
                            text="Play"
                            onAction="#btnPlayPressed"/>

                    <Button fx:id="btnRemove"
                            text="Remove"
                            onAction="#btnRemovePressed"/>

                </buttons>

            </ButtonBar>

        </VBox>

    </center>

    <right>

        <VBox alignment="TOP_CENTER"
              spacing="30">

            <padding>
                <Insets top="50"
                        left="20"
                        right="20"/>
            </padding>

            <HBox spacing="10"
                  alignment="CENTER">

                <Label text="Total:"
                       style="-fx-font-size: 24px;"/>

                <Label fx:id="labelTotalCost"
                       text="0 $"
                       style="-fx-font-size: 24px;
                              -fx-text-fill: cyan;"/>

            </HBox>

            <Button text="Place Order"
                    onAction="#btnPlaceOrderPressed"
                    prefWidth="200"
                    prefHeight="50"
                    style="-fx-font-size: 20px;
                           -fx-background-color: red;
                           -fx-text-fill: white;"/>

        </VBox>

    </right>

</BorderPane>